// ==============================================================================
// Prisma Schema — Smart WMS (Supabase PostgreSQL Compatible)
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  MANAGER
  STAFF
}

enum OrderType {
  INBOUND
  OUTBOUND
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  COMPLETED
  CANCELLED
}

// ── Models ───────────────────────────────────────────────────────────────────

model Profile {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  fullName  String?  @map("full_name")
  role      UserRole @default(STAFF)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdOrders  WarehouseOrder[] @relation("CreatedOrders")
  reviewedOrders WarehouseOrder[] @relation("ReviewedOrders")

  @@map("profiles")
}

model Product {
  id             String   @id @default(uuid()) @db.Uuid
  sku            String   @unique
  barcode        String   @unique
  name           String
  description    String?
  unit           String   @default("Cái")
  minSafetyStock Int      @default(0) @map("min_safety_stock")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  inventoryItems InventoryItem[]
  orderItems     WarehouseOrderItem[]
  stockLedgers   StockLedger[]

  @@index([barcode])
  @@index([sku])
  @@map("products")
}

model Location {
  id        String   @id @default(uuid()) @db.Uuid
  zone      String
  aisle     String
  rack      String
  bin       String
  barcode   String   @unique
  capacity  Int?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  inventoryItems InventoryItem[]
  orderItems     WarehouseOrderItem[]
  stockLedgers   StockLedger[]

  @@unique([zone, aisle, rack, bin])
  @@index([barcode])
  @@map("locations")
}

model InventoryItem {
  id               String   @id @default(uuid()) @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  locationId       String   @map("location_id") @db.Uuid
  quantityOnHand   Int      @default(0) @map("quantity_on_hand")
  quantityReserved Int      @default(0) @map("quantity_reserved")
  lotNumber        String?  @map("lot_number")
  expiryDate       String?  @map("expiry_date")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([productId, locationId])
  @@index([productId])
  @@index([locationId])
  @@map("inventory_items")
}

model WarehouseOrder {
  id         String      @id @default(uuid()) @db.Uuid
  orderCode  String      @unique @map("order_code")
  type       OrderType
  status     OrderStatus @default(DRAFT)
  createdBy  String?     @map("created_by") @db.Uuid
  reviewedBy String?     @map("reviewed_by") @db.Uuid
  note       String?
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  creator  Profile?             @relation("CreatedOrders", fields: [createdBy], references: [id], onDelete: SetNull)
  reviewer Profile?             @relation("ReviewedOrders", fields: [reviewedBy], references: [id], onDelete: SetNull)
  items    WarehouseOrderItem[]

  @@index([type])
  @@index([status])
  @@map("warehouse_orders")
}

model WarehouseOrderItem {
  id               String   @id @default(uuid()) @db.Uuid
  orderId          String   @map("order_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  locationId       String?  @map("location_id") @db.Uuid
  expectedQuantity Int      @map("expected_quantity")
  actualQuantity   Int      @default(0) @map("actual_quantity")
  lotNumber        String?  @map("lot_number")
  expiryDate       String?  @map("expiry_date")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order    WarehouseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product  Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  location Location?      @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("warehouse_order_items")
}

model StockLedger {
  id              String   @id @default(uuid()) @db.Uuid
  transactionType String   @map("transaction_type")
  productId       String   @map("product_id") @db.Uuid
  locationId      String   @map("location_id") @db.Uuid
  delta           Int
  balance         Int
  orderId         String?  @map("order_id") @db.Uuid
  createdBy       String?  @map("created_by") @db.Uuid
  note            String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([locationId])
  @@index([createdAt])
  @@map("stock_ledger")
}

model IdempotencyKey {
  key        String   @id
  path       String
  statusCode Int      @map("status_code")
  response   Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("idempotency_keys")
}
