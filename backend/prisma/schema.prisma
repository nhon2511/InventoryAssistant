// ==============================================================================
// Prisma Schema — Smart WMS (Supabase PostgreSQL Compatible)
// Aligned with Supabase PostgreSQL 17.6 Schema (TASK-DB-04A)
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────────
// Application enums used for validation and domain contracts.
// Note: In PostgreSQL schema, these values are stored as text.

enum UserRole {
  ADMIN
  MANAGER
  STAFF
}

enum OrderType {
  INBOUND
  OUTBOUND
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  COMPLETED
  CANCELLED
}

// ── Models ───────────────────────────────────────────────────────────────────

model Profile {
  id          String   @id @db.Uuid
  fullName    String   @map("full_name")
  role        String   @default("STAFF")
  phoneNumber String?  @map("phone_number")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("profiles")
}

model Product {
  id             String   @id @default(uuid()) @db.Uuid
  sku            String   @unique
  barcode        String   @unique
  name           String
  description    String?
  unit           String   @default("Pcs")
  minSafetyStock Int      @default(0) @map("min_safety_stock")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  inventoryItems InventoryItem[]
  orderItems     WarehouseOrderItem[]
  stockLedgers   StockLedger[]

  @@index([barcode])
  @@index([sku])
  @@map("products")
}

model Location {
  id              String   @id @default(uuid()) @db.Uuid
  zoneCode        String   @map("zone_code")
  aisleCode       String   @map("aisle_code")
  rackCode        String   @map("rack_code")
  binCode         String   @map("bin_code")
  locationBarcode String   @unique @map("location_barcode")
  maxCapacityKg   Decimal? @map("max_capacity_kg") @db.Decimal
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  inventoryItems InventoryItem[]
  orderItems     WarehouseOrderItem[]
  stockLedgers   StockLedger[]

  @@index([locationBarcode])
  @@map("locations")
}

model InventoryItem {
  id               String    @id @default(uuid()) @db.Uuid
  productId        String    @map("product_id") @db.Uuid
  locationId       String    @map("location_id") @db.Uuid
  quantityOnHand   Int       @default(0) @map("quantity_on_hand")
  quantityReserved Int       @default(0) @map("quantity_reserved")
  lotNumber        String?   @map("lot_number")
  expiryDate       DateTime? @map("expiry_date") @db.Date
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  stockLedgers StockLedger[]

  @@unique([productId, locationId, lotNumber])
  @@index([productId])
  @@index([locationId])
  @@map("inventory_items")
}

model WarehouseOrder {
  id        String   @id @default(uuid()) @db.Uuid
  orderCode String   @unique @map("order_code")
  type      String
  status    String   @default("DRAFT")
  createdBy String?  @map("created_by") @db.Uuid
  approvedBy String? @map("approved_by") @db.Uuid
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Both actor UUIDs target Supabase-managed auth.users; keep scalar fields.
  items   WarehouseOrderItem[]
  stockLedgers StockLedger[]

  @@index([type])
  @@index([status])
  // approved_by uses a partial database-owned index after migration 001.
  @@map("warehouse_orders")
}

model WarehouseOrderItem {
  id               String    @id @default(uuid()) @db.Uuid
  orderId          String    @map("order_id") @db.Uuid
  productId        String    @map("product_id") @db.Uuid
  locationId       String?   @map("location_id") @db.Uuid
  expectedQuantity Int       @map("expected_quantity")
  actualQuantity   Int       @default(0) @map("actual_quantity")
  lotNumber        String?   @map("lot_number")
  expiryDate       DateTime? @map("expiry_date") @db.Date
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  order    WarehouseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product  Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  location Location?      @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("warehouse_order_items")
}

// Planned in TASK-DB-04B; this model is unavailable until the migration is applied.
model StockLedger {
  id              String   @id @default(uuid()) @db.Uuid
  inventoryItemId String   @map("inventory_item_id") @db.Uuid
  transactionType String   @map("transaction_type")
  productId       String   @map("product_id") @db.Uuid
  locationId      String   @map("location_id") @db.Uuid
  delta           Int
  balance         Int
  orderId         String?  @map("order_id") @db.Uuid
  createdBy       String?  @map("created_by") @db.Uuid
  note            String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  order WarehouseOrder? @relation(fields: [orderId], references: [id], onDelete: Restrict)
  // createdBy is an immutable auth actor snapshot, without a physical FK.

  @@index([inventoryItemId, createdAt(sort: Desc), id(sort: Desc)], map: "stock_ledger_item_history_idx")
  @@index([productId, locationId, createdAt(sort: Desc), id(sort: Desc)], map: "stock_ledger_product_location_history_idx")
  @@index([orderId], map: "stock_ledger_order_id_idx")
  @@map("stock_ledger")
}

// Planned in TASK-DB-04B; this model is unavailable until the migration is applied.
model IdempotencyKey {
  scopeId          String   @map("scope_id") @db.Uuid
  key              String
  httpMethod       String   @map("http_method")
  requestPath      String   @map("request_path")
  requestHash      String   @map("request_hash") @db.Char(64)
  processingStatus String   @default("processing") @map("processing_status")
  statusCode       Int?     @map("status_code")
  response         Json?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  expiresAt        DateTime @map("expires_at") @db.Timestamptz(6)

  @@id([scopeId, key])
  @@index([expiresAt])

  @@map("idempotency_keys")
}
